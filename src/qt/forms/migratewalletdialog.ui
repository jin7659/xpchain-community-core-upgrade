     <item row="0" column="0">
      <widget class="QLabel" name="destinationLabel">
       <property name="text">
        <string>Destination</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="destinationEdit">
       <property name="placeholderText">
        <string>name.sqlite (under the wallets directory)</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="destinationHintLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>Must end with .sqlite. Relative paths are under the wallets data directory.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="replaceSourceCheckBox">
     <property name="toolTip">
      <string>Safely replaces the source wallet with the modern SQLite file, keeping the original as .legacy.bak. This ensures SQLite is loaded automatically on next start.</string>
     </property>
     <property name="text">
      <string>Replace current wallet with SQLite in-place (recommended)</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="backupCheckBox">
     <property name="text">
      <string>Backup source wallet before migration (recommended)</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="overwriteCheckBox">
     <property name="text">
      <string>Overwrite destination file if it already exists (back up existing first)</string>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="loadNewCheckBox">
     <property name="toolTip">
      <string>Unload the Berkeley DB wallet and open the new SQLite wallet in this session.</string>
     </property>
     <property name="text">
      <string>Switch to the migrated SQLite wallet after success</string>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="warningLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>After migration, verify your balance and send a small test transaction before relying on the new file.</string>
     </property>
    </widget>
