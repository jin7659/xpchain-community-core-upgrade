     <property name="font">
      <font>
       <pointsize>13</pointsize>
       <bold>true</bold>
      </font>
     </property>
     <property name="text">
      <string>Migrate Berkeley DB → SQLite</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="summaryLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string>Copy this wallet into a new SQLite file. The original Berkeley DB file is kept.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="walletInfoLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="text">
      <string/>
     </property>
    </widget>
   </item>
