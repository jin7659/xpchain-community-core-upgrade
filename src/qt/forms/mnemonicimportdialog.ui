  <property name="styleSheet">
   <string notr="true">QDialog { background-color: #1e1e1e; color: #ffffff; }
QLabel { color: #e0e0e0; font-size: 13px; }
QPlainTextEdit { background-color: #2b2b2b; color: #ffffff; border: 1px solid #3d3d3d; border-radius: 4px; padding: 6px; font-family: monospace; font-size: 13px; }
QLineEdit { background-color: #2b2b2b; color: #ffffff; border: 1px solid #3d3d3d; border-radius: 4px; padding: 6px; font-size: 13px; }
QPlainTextEdit:focus, QLineEdit:focus { border: 1px solid #106ba3; }
QCheckBox { color: #e0e0e0; font-size: 13px; spacing: 5px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #3d3d3d; border-radius: 3px; background-color: #2b2b2b; }
QCheckBox::indicator:checked { background-color: #106ba3; border: 1px solid #106ba3; }
QPushButton { background-color: #2b2b2b; color: #ffffff; border: 1px solid #3d3d3d; border-radius: 4px; padding: 6px 16px; min-width: 80px; }
QPushButton:hover { background-color: #106ba3; border: 1px solid #106ba3; color: #ffffff; font-weight: bold; }
QPushButton:pressed { background-color: #0d4f7a; }
</string>
