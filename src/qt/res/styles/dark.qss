/* XPChain Premium Dark Mode QSS StyleSheet */

QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI", "Outfit", "Inter", sans-serif;
    font-size: 13px;
}

/* Main Window */
QMainWindow {
    background-color: #121212;
}

/* Dialogs */
QDialog {
    background-color: #1a1a1a;
    border: 1px solid #2d2d2d;
    border-radius: 8px;
}

/* Menu Bar & Menu Items */
QMenuBar {
    background-color: #121212;
    border-bottom: 1px solid #252525;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #ff8000;
    color: #ffffff;
}

QMenu {
    background-color: #1a1a1a;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #ff8000;
    color: #ffffff;
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2a2a2a, stop:1 #1f1f1f);
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    color: #e0e0e0;
    padding: 6px 18px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #333333, stop:1 #242424);
    border: 1px solid #ff8000;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #ff8000;
    border: 1px solid #ff9500;
    color: #ffffff;
}

QPushButton:disabled {
    background: #1a1a1a;
    border: 1px solid #252525;
    color: #666666;
}

/* Inputs & LineEdits */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #1c1c1c;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    padding: 6px;
    color: #ffffff;
    selection-background-color: #ff8000;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #ff8000;
    background-color: #222222;
}

/* Tables & Trees */
QTableView, QTreeView, QTableWidget {
    background-color: #181818;
    alternate-background-color: #1f1f1f;
    border: 1px solid #2d2d2d;
    border-radius: 6px;
    gridline-color: #2a2a2a;
    color: #e0e0e0;
    selection-background-color: rgba(255, 128, 0, 0.2);
    selection-color: #ff8000;
}

QHeaderView::section {
    background-color: #222222;
    color: #a0a0a0;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #2d2d2d;
    font-weight: bold;
}

/* Tab Bar */
QTabBar::tab {
    background-color: #1a1a1a;
    border: 1px solid #2d2d2d;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background-color: #121212;
    border-bottom: 2px solid #ff8000;
    color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #252525;
    color: #ffffff;
}

/* Status Bar */
QStatusBar {
    background-color: #121212;
    border-top: 1px solid #252525;
    color: #888888;
}

QStatusBar::item {
    border: none;
}

/* ScrollBars */
QScrollBar:vertical {
    background-color: #121212;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2d2d2d;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ff8000;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #121212;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2d2d2d;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ff8000;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Tooltips */
QToolTip {
    background-color: #1a1a1a;
    border: 1px solid #ff8000;
    border-radius: 4px;
    color: #ffffff;
    padding: 4px;
}
