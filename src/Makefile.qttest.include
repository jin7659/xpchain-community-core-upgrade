bin_PROGRAMS += qt/test/test_xpchain-qt
TESTS += qt/test/test_xpchain-qt

TEST_QT_MOC_CPP = \
  qt/test/moc_compattests.cpp \
  qt/test/moc_rpcnestedtests.cpp \
  qt/test/moc_uritests.cpp

if ENABLE_WALLET
TEST_QT_MOC_CPP += \
  qt/test/moc_addressbooktests.cpp \
  qt/test/moc_paymentservertests.cpp \
  qt/test/moc_wallettests.cpp \
  qt/test/moc_mnemonictests.cpp
endif

TEST_QT_H = \
  qt/test/addressbooktests.h \
  qt/test/compattests.h \
  qt/test/rpcnestedtests.h \
  qt/test/uritests.h \
  qt/test/util.h \
  qt/test/paymentrequestdata.h \
  qt/test/paymentservertests.h \
  qt/test/wallettests.h \
  qt/test/mnemonictests.h

TEST_XPCHAIN_CPP = \
  test/test_xpchain.cpp

TEST_XPCHAIN_H = \
  test/test_xpchain.h

qt_test_test_xpchain_qt_CPPFLAGS = $(AM_CPPFLAGS) $(XPCHAIN_INCLUDES) $(XPCHAIN_QT_INCLUDES) \
  $(QT_INCLUDES) $(QT_TEST_INCLUDES) $(PROTOBUF_CFLAGS)

qt_test_test_xpchain_qt_SOURCES = \
  qt/test/compattests.cpp \
  qt/test/rpcnestedtests.cpp \
  qt/test/test_main.cpp \
  qt/test/uritests.cpp \
  qt/test/util.cpp \
  $(TEST_QT_H) \
  $(TEST_XPCHAIN_CPP) \
  $(TEST_XPCHAIN_H)
if ENABLE_WALLET
qt_test_test_xpchain_qt_SOURCES += \
  qt/test/addressbooktests.cpp \
  qt/test/paymentservertests.cpp \
  qt/test/wallettests.cpp \
  qt/test/mnemonictests.cpp \
  wallet/test/wallet_test_fixture.cpp
endif

nodist_qt_test_test_xpchain_qt_SOURCES = $(TEST_QT_MOC_CPP)

qt_test_test_xpchain_qt_LDADD = $(LIBXPCHAIN_QT) $(LIBXPCHAIN_SERVER)
if ENABLE_WALLET
qt_test_test_xpchain_qt_LDADD += $(LIBXPCHAIN_UTIL) $(LIBXPCHAIN_WALLET) $(LIBXPCHAIN_SERVER)
endif
if ENABLE_ZMQ
qt_test_test_xpchain_qt_LDADD += $(LIBXPCHAIN_ZMQ) $(ZMQ_LIBS)
endif
qt_test_test_xpchain_qt_LDADD += $(LIBXPCHAIN_CLI) $(LIBXPCHAIN_COMMON) $(LIBXPCHAIN_UTIL) $(LIBXPCHAIN_CONSENSUS) $(LIBXPCHAIN_CRYPTO) $(LIBUNIVALUE) $(LIBLEVELDB) \
  $(LIBLEVELDB_SSE42) $(LIBMEMENV) $(BOOST_LIBS) $(QT_DBUS_LIBS) $(QT_TEST_LIBS) $(QT_LIBS) \
  $(QR_LIBS) $(PROTOBUF_LIBS) $(BDB_LIBS) $(SSL_LIBS) $(CRYPTO_LIBS) $(MINIUPNPC_LIBS) $(LIBSECP256K1) \
  $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS) $(SQLITE3_LIBS)
qt_test_test_xpchain_qt_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(QT_LDFLAGS) $(LIBTOOL_APP_LDFLAGS)
qt_test_test_xpchain_qt_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)

CLEAN_XPCHAIN_QT_TEST = $(TEST_QT_MOC_CPP) qt/test/*.gcda qt/test/*.gcno

CLEANFILES += $(CLEAN_XPCHAIN_QT_TEST)

test_xpchain_qt : qt/test/test_xpchain-qt$(EXEEXT)

test_xpchain_qt_check : qt/test/test_xpchain-qt$(EXEEXT) FORCE
	$(MAKE) check-TESTS TESTS=$^

test_xpchain_qt_clean: FORCE
	rm -f $(CLEAN_XPCHAIN_QT_TEST) $(qt_test_test_xpchain_qt_OBJECTS)
